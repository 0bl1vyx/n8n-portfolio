    {
      "parameters": {
        "jsCode": "// 1. Separate the input items into two lists based on what fields they have\n// 'dataItems' are the ones with the parsed info (like programName)\nconst dataItems = items.filter(item => item.json.programName);\n\n// 'linkItems' are the ones that only have the link\nconst linkItems = items.filter(item => item.json.link);\n\n// 2. Loop through the data items and find the matching link by index\nconst results = dataItems.map((item, index) => {\n  const finalJson = item.json;\n\n  // Get the link from the corresponding index in the link list\n  // We use optional chaining (?.) to avoid errors if the list lengths differ\n  const originalLink = linkItems[index]?.json?.link;\n\n  // 3. Replace the URL if a link exists\n  if (originalLink) {\n    finalJson.url = originalLink;\n  }\n\n  return {\n    json: finalJson\n  };\n});\n\n// 4. Return the cleaned 10 items\nreturn results;"
      },
