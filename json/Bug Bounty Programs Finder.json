    {
      "parameters": {
        "jsCode": "// --- URL NORMALIZER ---\nfunction normalizeUrl(url) {\n  if (!url) return '';\n\n  try {\n    // Decode URL-encoded strings\n    url = decodeURIComponent(url);\n  } catch (e) {}\n\n  return url\n    .trim()\n    .toLowerCase()\n    .replace(/^https?:\\/\\//, '') // remove http / https\n    .replace(/\\/$/, '');         // remove trailing slash\n}\n\n// --- READ BLOCKED URLS FROM GOOGLE SHEETS ---\nconst blockedUrls = $(\"Get row(s) in sheet\").all()\n  .map(item => normalizeUrl(item.json.URL))\n  .filter(Boolean);\n\n// --- READ SEARCH RESULTS ---\nconst searchResults = $(\"Split Out\").all();\n\n// --- FILTER ---\nconst filtered = searchResults.filter(item => {\n  const link = item.json.link;\n  if (!link) return false;\n\n  const normalizedLink = normalizeUrl(link);\n\n  return !blockedUrls.some(blocked =>\n    normalizedLink.startsWith(blocked)\n  );\n});\n\n// --- OUTPUT ---\nreturn filtered;\n"
      },
