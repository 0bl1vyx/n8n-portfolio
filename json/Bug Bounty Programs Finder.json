      "parameters": {
        "jsCode": "// 1. Get raw text directly from the LLM output\nconst rawText = items[0].json.text;\n\nif (!rawText || typeof rawText !== 'string') {\n  return [];\n}\n\nconst parsedData = {};\n\n// 2. Split into lines\nconst lines = rawText.split('\\n');\n\nfor (const line of lines) {\n  const splitIndex = line.indexOf(':');\n  if (splitIndex === -1) continue;\n\n  const key = line.substring(0, splitIndex).trim();\n  const value = line.substring(splitIndex + 1).trim();\n\n  switch (key) {\n    case 'Program Name':\n      parsedData.programName = value;\n      break;\n    case 'URL':\n      parsedData.url = value;\n      break;\n    case 'Launch Status':\n      parsedData.launchStatus = value;\n      break;\n    case 'Scope':\n      parsedData.scope = value;\n      break;\n    case 'Reward Type':\n      parsedData.rewardType = value;\n      break;\n    case 'Submission Method':\n      parsedData.submissionMethod = value;\n      break;\n    case 'Notes':\n      parsedData.notes = value;\n      break;\n  }\n}\n\n// 3. Return a single n8n item\nreturn [{ json: parsedData }];"
      },
